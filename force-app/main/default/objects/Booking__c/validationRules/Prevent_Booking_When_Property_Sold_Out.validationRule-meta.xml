<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Booking_When_Property_Sold_Out</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL( Property__r.Status__c , &quot;Sold Out&quot;)</errorConditionFormula>
    <errorMessage>Cannot create booking because the property is sold out.</errorMessage>
</ValidationRule>
